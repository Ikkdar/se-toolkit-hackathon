# Docker image registry prefix (leave empty outside university network)
REGISTRY_PREFIX_DOCKER_HUB=

# Optional npm registry mirror (use default npmjs unless you have a mirror)
NPM_REGISTRY=https://registry.npmjs.org/

# Host bindings
BACKEND_HOST_ADDRESS=0.0.0.0
BACKEND_HOST_PORT=8000
FRONTEND_HOST_ADDRESS=0.0.0.0
FRONTEND_HOST_PORT=5173
OLLAMA_HOST_ADDRESS=0.0.0.0
OLLAMA_HOST_PORT=11434
QWEN_PROXY_HOST_ADDRESS=0.0.0.0
QWEN_PROXY_HOST_PORT=8080

# Frontend public API URL used at build time
FRONTEND_PUBLIC_API_BASE_URL=http://localhost:8000

# Qwen credentials mount path on VM host
QWEN_CREDS_HOST_PATH=${HOME}/.qwen
